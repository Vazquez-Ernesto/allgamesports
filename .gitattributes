# Los scripts y los parches se usan en Linux (WSL): siempre con fin de línea
# LF, aunque Git en Windows tenga core.autocrlf=true. Con CRLF, bash no
# entiende "set -euo pipefail" y git apply no encuentra las líneas del parche.
*.sh text eol=lf
*.patch text eol=lf
# Las versiones fijadas (UPSTREAM_TAG, UPSTREAM_COMMIT...) también las lee
# bash: con CRLF, git busca un commit que termina en \r y no lo encuentra.
UPSTREAM_* text eol=lf
