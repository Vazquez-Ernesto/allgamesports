msgstr ""

#: data/levels/world2/striking_wood.stl:3
msgid "Striking Wood"
msgstr ""

#: data/levels/world2/three_sheets_wind.stl:3
msgid "Three Sheets to the Wind"
msgstr ""

#: data/levels/world2/through_dark.stl:3
msgid "Through the Dark"
msgstr ""

#: data/levels/world2/tux_builder.stl:3
msgid "Tux the Builder"
msgstr ""

#: data/levels/world2/welcome_forest.stl:3
msgid "Welcome to the Forest"
msgstr ""

#: data/levels/world2/welcome_forest.stl:130
msgid ""
"-Doors\n"
"!images/objects/door/door-0.png\n"
"#Tux can go through a door by pressing the UP key.\n"
"#\n"
"#Some doors may require a key to enter!"
msgstr ""

#: data/levels/world2/wooden_roots.stl:3
msgid "Wooden Roots"
msgstr ""

#: data/levels/world2/worldmap.stwm:355
msgid "To be continued..."
msgstr ""

#: data/levels/world2/worldmap.stwm:363 data/levels/world2/worldmap.stwm:373
msgid "You found a secret area!"
msgstr ""

#: data/levels/world2/worse_salmonella.stl:3
msgid "Worse Than Salmonella"
msgstr ""
(supertux-level
  (version 3)
  (name (_ "A Mouldy Grotto"))
  (author "Carsten Wirtz")
  (license "CC-BY-SA 4.0 International")
  (target-time 170)
  (allow-item-pocket "inherit")
  (icon "")
  (icon-locked "")
  (statistics
    (enable-coins #t)
    (enable-secrets #t)
  )
  (sector
    (name "main")
    (ambient-light
      (color 1 1 1)
    )
    (background
      (color 1 1 1)
      (speed 0)
      (image-top "/images/background/misc/transparent_up.png")
      (image "/images/background/forest/mountain.png")
      (z-pos -250)
    )
    (background
      (color 1 1 1)
      (speed 0.5)
      (image-top "/images/background/misc/transparent_up.png")
      (image "/images/background/forest/trees_back.png")
      (image-bottom "/images/background/forest/trees_bottom.png")
      (z-pos -200)
    )
    (background
      (scroll-offset-y -50)
      (color 1 1 1)
      (speed 0.3)
      (image-top "/images/background/misc/transparent_up.png")
      (image "/images/background/forest/woodland.png")
      (image-bottom "/images/background/forest/woodland_bottom.png")
      (z-pos -220)
    )
    (background
      (scroll-offset-y -80)
