msgstr "Deja caer la pelota"

#: data/levels/world2/entangled_roots.stl:3
msgid "Entangled in Roots"
msgstr "Enredado en las raÃ­ces"

#: data/levels/world2/find_bigger_fish.stl:3
msgid "Find the Bigger Fish!"
msgstr "Â¡Encuentra el pez mÃ¡s grande!"

#: data/levels/world2/flooded_chambers.stl:3
msgid "Flooded Chambers"
