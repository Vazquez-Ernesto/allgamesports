#: data/levels/world2/floral_blossom.stl:3
msgid "Floral Blossom"
msgstr "Brote floral"

#: data/levels/world2/forest_intro.stl:3
msgid "A New Location"
msgstr "Una nueva ubicaciÃ³n"

#: data/levels/world2/ghosttree_boss.stl:3
msgid "Roots of All Evil"
msgstr "Las raÃ­ces de todos los males"

#: data/levels/world2/ghosttree_cutscene.stl:3
msgid "The Root Of The Problem"
msgstr "La raÃ­z del problema"

#: data/levels/world2/ghosttreewin_cutscene.stl:3
msgid "Nature Is Healing"
msgstr "La naturaleza estÃ¡ sanando"

#: data/levels/world2/going_underground.stl:3
