  (sector
    (name "main")
    (init-script "Camera.set_scale(1.2);

if(! (\"chase\" in state)){
  state.chase <- false;
  print(\"[DEBUG] Root chase has been initiated\\n\");
}

function start_chase(start){
  state.chase <- start;
}

start_chase(state.chase);

start_chase(false);")
