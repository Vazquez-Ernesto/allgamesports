    (scripttrigger
      (oneshot #t)
      (script "start_cutscene();

/// FIXME: Whenever tilemaps stop affecting sector size, remove \"water_move\" tilemap from this!

alarm1.set_enabled(true);
alarm2.set_enabled(true);
alarm3.set_enabled(true);
alarm_siren.start_playing();
alarm_siren.set_volume(0.2)

Effect.sixteen_to_nine(1);
Tux.use_scripting_controller(true);
water_move.start_moving();
wait(0.5);
Camera.start_earthquake(3, 0.05);
wait(1.5);
Camera.stop_earthquake();
wait(4.5);
water_move.fade(0, 0);
water_move.set_solid(false);
water.fade(1, 0);

sawblade2.set_node(1);
sawblade4.set_node(1);

sawblade1.start_moving();
sawblade2.start_moving();
sawblade3.start_moving();
sawblade4.start_moving();

sector.settings.add_object(\"dive-mine\", \"auto\", 2656, 2464, \"none\", \"\");
sector.settings.add_object(\"dive-mine\", \"auto\", 2384, 2048, \"none\", \"\");
sector.settings.add_object(\"dive-mine\", \"auto\", 2640, 1216, \"none\", \"\");

door2.goto_node(1);
Tux.use_scripting_controller(false);
alarm_siren.stop_playing();
Effect.four_to_three(1);

end_cutscene();")
