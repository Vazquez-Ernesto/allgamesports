0 -2 1009 1013 -2 1010 1014 -2 1013 -2 1010 -2 1014 -2 1013 1009 -2 1013 1014 -2 1009 1013 1014 1009 1014 1013 1009 -2 1013 -9 1014 1009 1013 1009 -3 1014 1010 -2 1009 1010 -2 1009 1013 1009 1010 1014 -2 1013 -2 1010 -2 1014 -2 1013 1010 -2 1013 -3 1009 1014 -3 1009 1014 1009 1013 -2 1014 -2 1009 -4 1014 -2 1009 1013 1014 1013 -3 1009 1014 1013 1010 1014 -2 1010 1014 1013 1014 1013 1014 1013 1014 1013 -2 1014 1013 -2 1014 1010 -2 1014 1013 1009 1014 -5 1009 1014 -2 1013 -5 1009 1013 1014 -3 1013 1014 -3 1013)
