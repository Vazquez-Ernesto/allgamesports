    (scripttrigger
      (oneshot #t)
      (script "start_cutscene();

Level.pause_target_timer();
Tux.deactivate();
Camera.set_scale(1.3);
Effect.sixteen_to_nine(0);
Camera.ease_scale(1.1, 3.5, \"EaseQuadOut\");
Tux.walk(110);
wait(1);
Camera.start_earthquake(3, 0.05);
wait(1);
Tux.walk(0);
root_entrance.goto_node(1);
wait(1);
Camera.stop_earthquake();
wait(0.5);

Camera.set_scale(1.1);
Tux.set_pos(226, Tux.get_y());
root_entrance.set_node(1);
Level.set_respawn_point(\"main\", \"start\");

Tux.activate();
Level.resume_target_timer();
Effect.four_to_three(0.3);

end_cutscene();")
