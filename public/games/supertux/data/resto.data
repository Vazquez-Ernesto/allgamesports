  (sector
    (name "chase")
    (init-script "Camera.set_scale(1.1);

local crushers = [c1, c2];

while(true) {
local rts_pos_y = p1.get_y();

foreach(crusher in crushers) {
  local pos_y = crusher.get_y();
  if (abs(pos_y - rts_pos_y) < 100) {
    crusher.set_pos(0, 0);
  }
}

wait(0);
}
")
