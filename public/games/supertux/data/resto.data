    (scripttrigger
      (oneshot #t)
      (script "start_cutscene();
Tux.use_scripting_controller(true);
Effect.sixteen_to_nine(1);

root_trap1.start_moving();
wait(0.5);
root_trap3.start_moving();

wait(0.1);

Camera.start_earthquake(7, 0.05);
Tux.disable_fancy_idling();

root_trap2.start_moving();
wait(0.2);
root_trap4.start_moving();
wait(1);
play_sound(\"sounds/explosion.wav\");
wait(0.5);

Tux.set_dir(true);

trap_cover.fade(0, 0.5);
ground_bg.start_moving();
ground_collapse.start_moving();
t.thunder();
wait(1);

Tux.set_dir(false);

t.lightning();

Camera.scale(1.1, 0.2);
wait(0.2);
play_sound(\"sounds/brick.wav\");
wait(1);
Camera.scale(1.2, 0.28);
wait(0.28);
play_sound(\"sounds/brick.wav\");

t.thunder();

wait(0.3);
Camera.scale(1.5, 3.7);

Tux.set_dir(true);

wait(1.7);

t.lightning();

stop_music(2);
Effect.fade_out(1);
wait(2);

t.thunder();

Tux.use_scripting_controller(false);
Level.spawn(\"underground\", \"underground\");

end_cutscene();")
