fade_in_music(\"music/antarctic/crystalmine_intro.ogg\", 3);
wait(1);

Tux.activate();
Effect.four_to_three(1);
Camera.set_mode(\"normal\");
// end cutscene; unskippable anyway
Camera.set_scale(1.2);")
