msgstr "El bosque enraizado"

#: data/levels/world2/info:3
msgid "Tux explores a new land, but a curse impedes his journey."
msgstr "Tux explora una nueva tierra, pero una maldiciÃ³n impide su viaje."

#: data/levels/world2/lost_sanctuary.stl:3
msgid "Lost Sanctuary"
msgstr "Santuario perdido"

#: data/levels/world2/mouldy_grotto.stl:3
msgid "A Mouldy Grotto"
msgstr "Una gruta mohosa"

#: data/levels/world2/mount_crushmore.stl:3
msgid "Mount Crushmore"
msgstr "Monte AplastamÃ¡s"

#: data/levels/world2/owls_skydive_commando.stl:3
