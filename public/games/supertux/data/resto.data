  )
  (sector
    (name "main")
    (init-script "root_attack0.goto_node(1);
Camera.start_earthquake(3, 0.05);
wait(1);
Camera.stop_earthquake();

if(!(\"init_script_run\" in sector)) {
 sector.init_script_run <- true;
while(1) {
 ///first move
 wait(2.5);
 play_sound(\"/sounds/thunder.wav\");
lighto.fade(0.2, 0.1);
 wait(2);
lighto.fade(0, 0.1);
 lightning.lightning();
 Camera.start_earthquake(3, 0.05);
 root_attack0.goto_node(0);
 root_attack1.goto_node(0);
 root_attack2.goto_node(0);
 root_attack3.goto_node(0);
 root_attack4.goto_node(0);
 root_attack5.goto_node(0);
 root_attack6.goto_node(0);
 root_attack7.goto_node(0);
 root_attack8.goto_node(0);
 root_attack9.goto_node(0);
 root_attack10.goto_node(0);
 root_attack11.goto_node(0);
 root_attack12.goto_node(0);
 root_attack13.goto_node(0);
 root_attack14.goto_node(0);
 root_attack15.goto_node(0);

 wait(1.19);
 Camera.stop_earthquake();

 ///second move
 wait(2.5);
 play_sound(\"/sounds/thunder.wav\");
lighto.fade(0.2, 0.1);
 wait(2);
lighto.fade(0, 0.1);
 lightning.lightning();
 Camera.start_earthquake(3, 0.05);
 root_attack0.goto_node(1);
 root_attack1.goto_node(1);
 root_attack2.goto_node(1);
 root_attack3.goto_node(1);
 root_attack4.goto_node(1);
 root_attack5.goto_node(1);
 root_attack6.goto_node(1);
 root_attack7.goto_node(1);
 root_attack8.goto_node(1);
 root_attack9.goto_node(1);
 root_attack10.goto_node(1);
 root_attack11.goto_node(1);
 root_attack12.goto_node(1);
 root_attack13.goto_node(1);
 root_attack14.goto_node(1);
 root_attack15.goto_node(1);

 wait(1.19);
 Camera.stop_earthquake();
}
}")
