  (sector
    (name "party")
    (init-script "

import(\"levels/bonus1/tux_parties_like_a.nut\");

init()

// background colour changer
local keep_looping = true;
while (keep_looping) {
wait(0.5);
partylights.tint_fade(0, 134, 217, 0, 0.2); //green
wait(1);
partylights.tint_fade(0, 205, 0, 96, 0.2); //purple
