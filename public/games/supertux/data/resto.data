  (sector
    (name "main")
    (init-script "::candlesCount <- 0;

function candleBlow(){
candlesCount++;

if (candlesCount == 4){
Ncutscene();
}
}


function Ncutscene(){

start_cutscene();
Camera.set_mode(\"manual\");
Effect.sixteen_to_nine(1);
Tux.deactivate();
wait(0.7);

Camera.scroll_to(0, 600, 1);
wait(1);
secretplatform.start_moving();
sp1.fade(0, 1);
wait(2.2);

Tux.activate();
Effect.four_to_three(1);
Camera.set_mode(\"normal\");
end_cutscene();

}")
