ŸlèTeÔ²Ÿ.Ş­ né‹âÎñğ#õq¾m#TtìóoPrœ@šº␀¢™ÆNl (JÚC¦$WA«ãSşÅ±>]k0bèì=¯9™u—sj%`¥’R³¨/âû8¸HÇÅ¸±«g6OµÏDUï6çŒ¹šÉDÕ8DX†’æ^*€¢–öŒ“‘œçpßúÇrØB8FÑds~Ë(…œŒßZê85³a¦fvf@™É·Ò;sŞîC;(WX•Jjæî9ºìcv␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀#!/bin/sh

set -e

OUTPUTDIR="6db-less"

mkdir "$OUTPUTDIR"

for i in *.wav; do
    cp -vi "$i" "${OUTPUTDIR}/${i}"
    normalize-audio -g -6db "${OUTPUTDIR}/${i}"
done

for i in *.ogg; do
    oggdec "$i" -o "${OUTPUTDIR}/${i%%.ogg}.wav"
    normalize-audio -g -6db "${OUTPUTDIR}/${i%%.ogg}.wav"
    oggenc "${OUTPUTDIR}/${i%%.ogg}.wav"
    rm "${OUTPUTDIR}/${i%%.ogg}.wav"
done

# EOF #
