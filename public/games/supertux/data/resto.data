      (z-pos -15)
      (dead-script "start_cutscene();

Effect.sixteen_to_nine(1);
Tux.use_scripting_controller(true);
Effect.fade_out(1);

wait(1.5);

Camera.start_earthquake(2, 0.05);
Camera.set_pos(9200, 760);
Camera.set_scale(1.2);
Effect.fade_in(1);
root_barrier1.start_moving();
root_barrier2.start_moving();
root_barrier3.start_moving();
Camera.scale(1.4, 6);
wait(5);
Effect.fade_out(1);

wait(1.5);

Camera.set_mode(\"normal\");
Camera.stop_earthquake();
Camera.set_scale(1);
Effect.fade_in(1);
wait(1);

end_cutscene();

Effect.four_to_three(1);
Tux.use_scripting_controller(false);")
