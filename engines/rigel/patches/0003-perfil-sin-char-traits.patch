+// allgamesports: la biblioteca de JSON incluida lee los bytes con
+// std::char_traits<unsigned char>, que las versiones nuevas de la biblioteca
+// estandar de C++ (libc++) eliminaron. Se le pasan los mismos bytes como char.
+static nlohmann::json parseMsgpack(const assets::ByteBuffer& buffer)
+{
+  const auto pBegin = reinterpret_cast<const char*>(buffer.data());
+  return nlohmann::json::from_msgpack(pBegin, pBegin + buffer.size());
+}
